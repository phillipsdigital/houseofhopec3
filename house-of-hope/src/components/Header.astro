---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => path === href;
---

{
  site.announcement.show && (
    <div class="announce">
      {site.announcement.text}
      <span aria-hidden="true">&nbsp;|&nbsp;</span>
      <a href={site.donateUrl}>{site.announcement.linkText}</a>
    </div>
  )
}

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={64} height={64} class="brand__logo" loading="eager" />
      <span class="brand__text">
        <span class="brand__name">HOUSE OF HOPE</span>
        <span class="brand__sub">CHRISTIAN COUNSELING CENTER</span>
      </span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line class="l1" x1="3" y1="6" x2="21" y2="6"></line>
        <line class="l2" x1="3" y1="12" x2="21" y2="12"></line>
        <line class="l3" x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--orange nav__donate" href={site.donateUrl}>Donate</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    navEl?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .announce {
    background: var(--green-deep);
    color: var(--white);
    text-align: center;
    padding: 12px 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .announce a {
    color: var(--orange-light);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand__logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.08em;
  }
  .brand__sub {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--green-text);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px 30px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nav a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  .nav a:not(.btn):hover {
    color: var(--green-text);
  }
  .nav a[aria-current='page'] {
    color: var(--green-text);
    border-bottom-color: var(--orange);
  }
  .nav__donate {
    min-height: 46px;
    padding: 0 26px;
    font-size: 14px;
  }

  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  @media (max-width: 1020px) {
    .brand__logo {
      width: 52px;
      height: 52px;
    }
    .brand__name {
      font-size: 19px;
    }
    .brand__sub {
      font-size: 10px;
      letter-spacing: 0.18em;
    }
    .menu-btn {
      display: inline-flex;
    }
    .nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0 12px;
    }
    .nav.is-open {
      display: flex;
    }
    .nav a:not(.btn) {
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
    }
    .nav a[aria-current='page'] {
      border-bottom-color: var(--line);
    }
    .nav__donate {
      margin-top: 16px;
    }
  }
</style>
