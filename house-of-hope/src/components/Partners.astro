---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import montvale from '../assets/images/partners/montvale.png';
import hommaa from '../assets/images/partners/hommaa.png';
import schuberMitchell from '../assets/images/partners/schuber-mitchell.png';
import cogop from '../assets/images/partners/cogop.png';
import parkPlaza from '../assets/images/partners/park-plaza.png';
import hopeHaitian from '../assets/images/partners/hope-haitian.png';

// Every logo sits in an identical tile and is scaled to fit inside it.
// Logos that come on a colored background get a tile in that same color,
// so the logo blends into its tile instead of looking like a sticker.
// Add `url` to any partner to make its tile a link.
interface Partner {
  name: string;
  logo: ImageMetadata;
  tile?: string;
  url?: string;
}

const partners: Partner[] = [
  { name: 'Montvale Church', logo: montvale, tile: '#1b45df' },
  { name: 'Helping Others Ministry (HOMMAA)', logo: hommaa },
  { name: 'Schuber Mitchell Homes', logo: schuberMitchell, tile: '#4a5f42' },
  { name: 'Church of God of Prophecy', logo: cogop },
  { name: 'Park Plaza Christian Church', logo: parkPlaza },
  { name: 'Hope Haitian Ministries', logo: hopeHaitian },
];
---

<section class="partners">
  <div class="wrap stack center" style="gap: 32px;">
    <div class="stack center" style="gap: 12px;">
      <p class="eyebrow" style="color: var(--ink-soft);">With gratitude to our partner churches &amp; organizations</p>
      <p class="partners__note">Thank you to all of our wonderful ministry partners for supporting our work.</p>
    </div>
    <ul class="partners__grid">
      {
        partners.map((p) => {
          const img = <Image src={p.logo} alt={p.name} widths={[200, 400]} sizes="200px" class="partners__logo" />;
          return (
            <li class="partners__tile" style={p.tile ? `background: ${p.tile}; border-color: ${p.tile};` : undefined}>
              {p.url ? <a href={p.url}>{img}</a> : img}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .partners {
    padding: 72px 0;
    background: var(--sand);
    border-top: 1px solid var(--line);
  }
  .partners__note {
    margin: 0;
    color: var(--ink-soft);
  }
  .partners__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .partners__tile {
    aspect-ratio: 3 / 2;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partners__tile a {
    display: contents;
  }
  .partners__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 1000px) {
    .partners__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .partners__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .partners__tile {
      padding: 12px 14px;
    }
  }
</style>
