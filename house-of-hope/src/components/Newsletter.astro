---
import { site } from '../data/site';
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="wrap newsletter__inner">
    <div class="newsletter__copy">
      <h2 id="newsletter-title" class="h2">Stay close to the work.</h2>
      <p>Stories, prayer requests and project updates from Haiti, in your inbox.</p>
      <p><a href={site.newsletterArchiveUrl}>Read past newsletters</a></p>
    </div>
    <a class="btn btn--solid-dark newsletter__btn" href={site.newsletterUrl}>Subscribe</a>
  </div>
</section>

<style>
  .newsletter {
    background: var(--orange);
    padding: 88px 0;
  }
  .newsletter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .newsletter__copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 560px;
  }
  .newsletter .h2 {
    font-size: clamp(28px, 3vw, 38px);
    color: var(--ink);
  }
  .newsletter p {
    margin: 0;
    font-size: 18px;
    color: #2b2418;
  }
  .newsletter p a {
    color: var(--ink);
    font-weight: 600;
  }
  .newsletter__btn {
    min-height: 56px;
    padding: 0 40px;
  }
</style>
