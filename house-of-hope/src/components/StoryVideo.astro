---
// Founder video: thumbnail with a play button that opens the video in a lightbox.
import { Image } from 'astro:assets';
import thumb from '../assets/images/founder-video.jpg';
import { site } from '../data/site';
---

<section class="section section--dark" id="story">
  <div class="wrap split">
    <div class="stack">
      <p class="eyebrow eyebrow--light">Our story</p>
      <h2 class="h2">The story behind House of Hope.</h2>
      <p class="lead">
        Hear from founder Obias Exilus about why House of Hope began, and the healing we see God bringing to Haitian families.
      </p>
      <div><button type="button" class="btn btn--ghost" data-video-open>Watch the video</button></div>
    </div>

    <button type="button" class="video-thumb" data-video-open aria-label="Play the House of Hope story video">
      <Image src={thumb} alt="Obias Exilus, founder of House of Hope" class="video-thumb__img" />
      <span class="video-thumb__play" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 21 12 7 20 7 4"></polygon></svg>
      </span>
    </button>
  </div>

  <dialog class="video-dialog" aria-label="The story behind House of Hope">
    <button type="button" class="video-dialog__close" data-video-close aria-label="Close video">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
    </button>
    <video controls playsinline preload="none" poster={thumb.src}>
      <source src={site.videoUrl} type="video/mp4" />
    </video>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
  const video = dialog?.querySelector('video');
  document.querySelectorAll('[data-video-open]').forEach((el) =>
    el.addEventListener('click', () => {
      dialog?.showModal();
      video?.play().catch(() => {});
    }),
  );
  const close = () => {
    video?.pause();
    dialog?.close();
  };
  dialog?.querySelector('[data-video-close]')?.addEventListener('click', close);
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog?.addEventListener('close', () => video?.pause());
</script>

<style>
  .video-thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #393632;
    cursor: pointer;
  }
  .video-thumb__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .video-thumb__play {
    position: relative;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s;
  }
  .video-thumb:hover .video-thumb__play {
    transform: scale(1.06);
  }

  .video-dialog {
    width: min(960px, 92vw);
    padding: 0;
    border: 0;
    background: #000;
    overflow: visible;
  }
  .video-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .video-dialog video {
    display: block;
    width: 100%;
    max-height: 80vh;
  }
  .video-dialog__close {
    position: absolute;
    top: -52px;
    right: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
</style>
