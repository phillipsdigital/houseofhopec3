---
// Photo banner used at the top of inner pages.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  /** CSS object-position for the photo */
  position?: string;
}

const { eyebrow, title, lead, image, alt, position = 'center' } = Astro.props;
---

<section class="page-hero">
  <Image src={image} alt={alt} class="page-hero__img" style={`object-position: ${position}`} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
  <div class="page-hero__shade">
    <div class="wrap page-hero__content">
      <p class="eyebrow eyebrow--light">{eyebrow}</p>
      <h1 class="h1">{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    background: #3a3428;
    overflow: hidden;
  }
  .page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__shade {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    background:
      linear-gradient(90deg, rgba(16, 20, 13, 0.9) 0%, rgba(16, 20, 13, 0.72) 50%, rgba(16, 20, 13, 0.45) 100%),
      linear-gradient(0deg, rgba(36, 70, 26, 0.35) 0%, rgba(36, 70, 26, 0) 60%);
  }
  .page-hero__content {
    width: 100%;
    padding-top: 120px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .page-hero .h1 {
    color: var(--white);
    max-width: 800px;
    font-size: clamp(38px, 5vw, 64px);
  }
  .page-hero__lead {
    margin: 0;
    max-width: 640px;
    font-size: clamp(18px, 1.6vw, 20px);
    color: #f1efea;
  }
</style>
