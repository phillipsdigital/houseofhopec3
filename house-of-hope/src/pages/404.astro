---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" hideNewsletter>
  <section class="section">
    <div class="wrap wrap--narrow stack center" style="gap: 24px; padding: 40px 0;">
      <p class="eyebrow eyebrow--orange">404</p>
      <h1 class="h2">We couldn’t find that page.</h1>
      <p class="lead">It may have moved. Try one of these instead.</p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn--orange" href="/">Go home</a>
        <a class="btn btn--dark" href="/get-involved/#contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
