---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import Testimonials from '../components/Testimonials.astro';
import deschapelles from '../assets/images/deschapelles.jpg';
import hero from '../assets/images/hero.jpg';
import community from '../assets/images/community.jpg';
import groupCounseling from '../assets/images/group-counseling.jpg';
import training from '../assets/images/training.jpg';
import camp from '../assets/images/camp.jpg';
import soccer from '../assets/images/gallery/soccer.jpg';
import kidsCelebrating from '../assets/images/gallery/kids-celebrating.jpg';
import youthPair from '../assets/images/gallery/youth-pair.jpg';
import campArrival from '../assets/images/gallery/camp-arrival.jpg';
import volunteers from '../assets/images/gallery/volunteers.jpg';
import leaderAndChild from '../assets/images/gallery/leader-and-child.jpg';
import youthGroup from '../assets/images/gallery/youth-group.jpg';
import ceremony from '../assets/images/gallery/ceremony.jpg';
import schoolAssembly from '../assets/images/gallery/school-assembly.jpg';
import { site } from '../data/site';

// Gallery layout: 3 columns, every row the same height.
//   wide = spans 2 columns (landscape shots)
//   tall = spans 2 rows (portrait shots)
// The order below is planned so the grid fills with no gaps on desktop.
// `pos` sets which part of each photo stays in view when it is cropped.
type Shape = 'wide' | 'tall' | undefined;
const gallery: { src: ImageMetadata; alt: string; pos: string; shape?: Shape }[] = [
  { src: hero, alt: 'Training graduates holding their certificates with the House of Hope team', pos: 'center 35%', shape: 'wide' },
  { src: soccer, alt: 'Young athletes in training bibs running laps on a grass field', pos: 'center 40%', shape: 'tall' },
  { src: groupCounseling, alt: 'A calm group counseling session in an open-air room', pos: 'center' },
  { src: camp, alt: 'Youth camp participants gathered together outdoors', pos: 'center 60%' },
  { src: youthPair, alt: 'Two young people standing in front of a Helping Others Ministry banner', pos: 'center 40%', shape: 'tall' },
  { src: kidsCelebrating, alt: 'A crowd of children raising their hands under a tin-roofed shelter', pos: 'center 55%', shape: 'wide' },
  { src: training, alt: 'Local leaders taking part in a mental health training workshop', pos: 'center 60%' },
  { src: volunteers, alt: 'Three smiling volunteers wearing House of Hope name badges', pos: 'center 30%' },
  { src: deschapelles, alt: 'The Deschapelles counseling building under construction', pos: '62% center', shape: 'wide' },
  { src: campArrival, alt: 'Campers with their bags gathering beside a bus on arrival day', pos: 'center 60%', shape: 'tall' },
  { src: leaderAndChild, alt: 'A young leader with his arm around a smiling child in front of a ministry banner', pos: 'center 40%', shape: 'tall' },
  { src: community, alt: 'A stone path leading to a small green-roofed building in the community', pos: '45% center' },
  { src: youthGroup, alt: 'A group of young people and adults standing together in front of a ministry banner', pos: 'center 45%', shape: 'wide' },
  { src: ceremony, alt: 'Church and ministry leaders standing with a student holding her certificate at a recognition ceremony', pos: 'center 35%', shape: 'wide' },
  { src: schoolAssembly, alt: 'Students in school uniforms gathered for an assembly outside their school in Deschapelles', pos: 'center 60%' },
];
---

<BaseLayout
  title="Our Work"
  description="See House of Hope's work in Haiti, including the new counseling space being built in Deschapelles with a local school."
>
  <PageHero
    eyebrow="Our work"
    title="Building places of healing in Haiti."
    lead="From counseling sessions to training graduations to new buildings, here’s what your support makes possible."
    image={deschapelles}
    alt="Workers finishing the new House of Hope counseling building in Deschapelles"
    position="center 40%"
  />

  <section class="section">
    <div class="wrap">
      <ProjectFeature detailed />
    </div>
  </section>

  <!-- Gallery -->
  <section class="section section--sand">
    <div class="wrap stack stack--lg">
      <div class="section-head">
        <div class="stack" style="gap: 20px;">
          <p class="eyebrow">In the field</p>
          <h2 class="h2">Moments from the ministry.</h2>
        </div>
        <a class="text-link" href={site.facebookUrl}>More on Facebook →</a>
      </div>
      <div class="gallery">
        {
          gallery.map((g) => (
            <Image
              src={g.src}
              alt={g.alt}
              class:list={['gallery__img', g.shape && `gallery__img--${g.shape}`]}
              style={`object-position: ${g.pos}`}
              widths={[500, 900, 1400]}
              sizes={g.shape === 'wide' ? '(max-width: 520px) 100vw, 780px' : '(max-width: 520px) 100vw, 390px'}
            />
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials tone="green" heading="What we hear from the schools we serve." />

  <!-- Updates -->
  <section class="section">
    <div class="wrap grid3">
      <div class="card">
        <p class="eyebrow">Newsletter</p>
        <h3 class="h3">Read our updates</h3>
        <p>Catch up on stories, prayer requests and progress reports from past newsletters.</p>
        <a class="text-link card__foot" href={site.newsletterArchiveUrl}>Past newsletters →</a>
      </div>
      <div class="card">
        <p class="eyebrow">Social</p>
        <h3 class="h3">Follow along</h3>
        <p>We share photos and news from Haiti on Facebook as the work happens.</p>
        <a class="text-link card__foot" href={site.facebookUrl}>Follow on Facebook →</a>
      </div>
      <div class="card card--green">
        <p class="eyebrow eyebrow--peach">Partner with us</p>
        <h3 class="h3">Help finish Deschapelles</h3>
        <p>Around $3,000 will complete the counseling space for parents and students.</p>
        <div class="card__foot"><a class="btn btn--orange" href={site.donateUrl}>Give now</a></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Every row has the same height; each photo is cropped (object-fit: cover)
     to fill its cell, so nothing is ever stretched. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(200px, 22vw, 290px);
    grid-auto-flow: dense;
    gap: 16px;
  }
  .gallery__img--tall {
    grid-row: span 2;
  }
  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .gallery__img--wide {
    grid-column: span 2;
  }
  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(160px, 34vw, 260px);
    }
  }
  @media (max-width: 520px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
    }
    .gallery__img,
    .gallery__img--wide {
      grid-column: auto;
      grid-row: auto;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .gallery__img--tall {
      grid-row: auto;
      aspect-ratio: 4 / 5;
    }
  }
</style>
